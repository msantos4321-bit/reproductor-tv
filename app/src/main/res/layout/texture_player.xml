<?xml version="1.0" encoding="utf-8"?>
<!-- Reproductor sin controles con TextureView: se puede recortar, escalar y poner varios en pantalla -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:descendantFocusability="blockDescendants"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="#000000"
    app:keep_content_on_player_reset="false" />
